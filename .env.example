# Copy to .env.local and fill in. In Vercel, add the same variables under
# Project Settings > Environment Variables.

# Random secret that encrypts the session cookie: npx auth secret
AUTH_SECRET=

# The OAuth client created in Tiquo (Settings > Identity Provider)
AUTH_TIQUO_ID=
AUTH_TIQUO_SECRET=
AUTH_TIQUO_ISSUER=https://auth.tiquo.app
